library(fpp3)
library(tidyverse)
library(here)
inflacion <- read_csv(here( "DATA.csv"), show_col_types = FALSE) |>
  mutate(fecha = yearmonth(fecha)) |>
  select(-Date) |>
  as_tsibble(index = fecha) #|>
#mutate(across(
